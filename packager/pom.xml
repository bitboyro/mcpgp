<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ro.bitboy.mcpgp</groupId>
    <artifactId>mcpgp-parent</artifactId>
    <version>0.2.7</version>
  </parent>

  <artifactId>mcpgp-packager</artifactId>
  <name>mcpgp packager</name>
  <description>Packages (packaging.md): server jar, config schema, docs, checksums and signatures</description>

  <dependencies>
    <dependency>
      <groupId>ro.bitboy.mcpgp</groupId>
      <artifactId>mcpgp-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- DeliveryTest: the desktop bundle's settings configure the real runtime -->
    <dependency>
      <groupId>ro.bitboy.mcpgp</groupId>
      <artifactId>mcpgp-runtime</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- the packager carries the server runtime, so builds (CLI and platform) need neither Maven nor the network.
           The runtime module is built first (module order); its exec jar is copied in as a resource. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>bundle-runtime</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/mcpgp/runtime</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../runtime/target</directory>
                  <includes>
                    <include>mcpgp-runtime-${project.version}-exec.jar</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
