# Copy to .env and adjust. No secrets here: passwords live in secrets/ (see secrets/README.md).
MCPGP_PUBLIC_URL=http://localhost:8443
MCPGP_WORKSPACE=acme
MCPGP_ADMIN=admin
# where the port is published: 127.0.0.1 (this machine only), or 0.0.0.0 behind a firewall or proxy
MCPGP_BIND=127.0.0.1
MCPGP_PORT=8443
# MCPGP_IMAGE=registry.example.com/mcpgp-platform:0.1.0
