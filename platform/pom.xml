<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ro.bitboy.mcpgp</groupId>
    <artifactId>mcpgp-parent</artifactId>
    <version>0.4.0</version>
  </parent>

  <artifactId>mcpgp-platform</artifactId>
  <name>mcpgp platform</name>
  <description>The self-hosted platform: definition store, builds, identities, REST API (spec/platform-api.md)</description>

  <properties>
    <!-- the commit the platform is built from; CI and the image build pass it, a plain local build says unknown -->
    <mcpgp.commit>unknown</mcpgp.commit>
    <!-- Spring maps @PathVariable / @RequestParam by parameter name -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <!-- the web UI (platform/web) is built with its own Node, as in the other bitboy.ro projects;
         -Dskip.installnodenpm -Dskip.npm builds the platform without it -->
    <node.version>v22.12.0</node.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>ro.bitboy.mcpgp</groupId>
      <artifactId>mcpgp-packager</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- company sign-in (spec/platform-api.md §3): OIDC, and LDAP / Active Directory -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-ldap</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- the PostgreSQL store (storage.type: postgres); versions from Spring Boot's dependency management -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the platform MCP server, run against the platform in PlatformMcpTest -->
    <!-- tests build a sample extension against it -->
    <dependency>
      <groupId>ro.bitboy.mcpgp</groupId>
      <artifactId>mcpgp-extension-api</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ro.bitboy.mcpgp</groupId>
      <artifactId>mcpgp-runtime</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- an in-memory directory for the LDAP sign-in tests -->
    <dependency>
      <groupId>com.unboundid</groupId>
      <artifactId>unboundid-ldapsdk</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the platform MCP server's project (definition and the API's OpenAPI document): served at
           /api/v1/openapi.json, and packaged on request for agents -->
      <resource>
        <directory>mcp</directory>
        <targetPath>mcpgp/platform-mcp</targetPath>
      </resource>
      <!-- the Docker Compose files, for the setup command (never the secrets or a local .env) -->
      <resource>
        <directory>../deploy</directory>
        <targetPath>mcpgp/deploy</targetPath>
        <includes>
          <include>compose*.yaml</include>
          <include>platform.yaml</include>
          <include>.env.example</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <configuration>
          <workingDirectory>web</workingDirectory>
          <installDirectory>target</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>ci --no-audit --no-fund</arguments>
            </configuration>
          </execution>
          <execution>
            <!-- into target/classes/static, before the tests that serve it -->
            <id>npm-build</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-test</id>
            <goals><goal>npm</goal></goals>
            <phase>test</phase>
            <configuration>
              <arguments>test</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- META-INF/build-info.properties: the version, the build time (project.build.outputTimestamp when set,
               else when it was built, never when it starts) and the commit given as -Dmcpgp.commit; shown in the UI -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <additionalProperties>
                <commit>${mcpgp.commit}</commit>
              </additionalProperties>
            </configuration>
          </execution>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <classifier>exec</classifier>
              <mainClass>ro.bitboy.mcpgp.platform.PlatformServer</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
