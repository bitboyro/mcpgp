{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitboyro.github.io/mcpgp/schemas/manifest.schema.json",
  "title": "mcpgp manifest",
  "description": "Compiler output consumed by runtimes. See docs/spec/manifest.md.",
  "type": "object",
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "server": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "title": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "cli": { "type": "string" },
        "definition": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "source": { "type": "string" },
            "digest": { "$ref": "#/$defs/digest" }
          },
          "required": ["name", "digest"],
          "additionalProperties": false
        },
        "lock": {
          "type": ["object", "null"],
          "properties": { "digest": { "$ref": "#/$defs/digest" } },
          "required": ["digest"],
          "additionalProperties": false
        },
        "extends": {
          "type": ["object", "null"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } },
            "required": ["path", "digest"],
            "additionalProperties": false
          }
        }
      },
      "required": ["createdAt", "cli", "definition"],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "minRuntime": { "type": "string" },
        "mcpRevisions": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "minItems": 1 },
        "transports": { "$ref": "#/$defs/allowedDefault" },
        "inboundAuth": { "$ref": "#/$defs/allowedDefault" }
      },
      "required": ["mcpRevisions", "transports"],
      "additionalProperties": false
    },
    "instances": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["single", "multi"] },
        "mixedContracts": { "enum": ["union", "namespaced", "forbid"] },
        "max": { "type": ["integer", "null"] }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "apis": { "type": "array", "items": { "$ref": "#/$defs/api" }, "minItems": 1 },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["plain", "discovery", "toolsets", "hybrid"] },
        "discoveryStyle": { "enum": ["search", "catalog"] },
        "pinned": { "type": "array", "items": { "type": "string" } },
        "plainSearch": { "type": "boolean" },
        "toolsets": {
          "type": "object",
          "description": "toolsets mode: the groups, resolved; each lists its tools",
          "additionalProperties": {
            "type": "object",
            "required": ["description", "tools"],
            "properties": { "description": { "type": "string" }, "tools": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "prompts": {
      "type": "array",
      "description": "prompt templates from the definition (tools-contract §14.2); absent when there are none",
      "items": {
        "type": "object",
        "required": ["name", "arguments", "messages"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "arguments": { "type": "array", "items": { "type": "object", "required": ["name"] } },
          "messages": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["role", "content"] } }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "description": "GET operations exposed as MCP resources (tools-contract §14.1); absent when there are none",
      "required": ["uriScheme", "items"],
      "properties": {
        "uriScheme": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*$" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "api", "uriTemplate", "mimeType", "variants"],
            "properties": {
              "kind": { "const": "resource" },
              "uriTemplate": { "type": "string" },
              "mimeType": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "properties": {
        "confirmDestructive": { "type": "boolean" },
        "batch": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "maxCalls": {"type": "integer", "minimum": 1, "maximum": 100}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "allowWrites": {"type": "boolean"}, "deduplicateRequests": {"type": "boolean"}, "requestReceiptTtlSeconds": {"type": "integer", "minimum": 60, "maximum": 2592000}, "maxStoredReceipts": {"type": "integer", "minimum": 1, "maximum": 1000000}}, "additionalProperties": false},
        "results": {"type": "object", "properties": {"mode": {"enum": ["inline", "auto", "reference"]}, "captureLimitKb": {"type": "integer", "minimum": 1, "maximum": 65536}, "ttlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "maxStoredKb": {"type": "integer", "minimum": 1, "maximum": 262144}}, "additionalProperties": false},
        "responseLimitKb": { "type": "integer" },
        "cleanTruncation": { "type": "boolean" },
        "outputSchemas": { "description": "Tools carry an outputSchema (definition schemas.output)", "type": "boolean" },
        "inputLimits": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "requestKb": { "type": "integer" }, "stringMaxLength": { "type": "integer" } },
          "additionalProperties": false
        },
        "rateLimits": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "concurrent": { "type": "integer" }, "perMinute": { "type": "integer" }, "retryAfter": { "type": "boolean" } },
          "additionalProperties": false
        },
        "files": { "type": "object" },
        "redaction": { "type": "object" },
        "baseUrlAllowlist": { "type": "array", "items": { "type": "string" } },
        "runtimeDefaults": { "type": "object" }
      },
      "required": ["confirmDestructive"],
      "additionalProperties": false
    },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "extensions": {
      "type": "object",
      "description": "Custom code the package contains (extensions.md): jars with their checksums, and the enrichers and call filters in the order they run. Custom tools are in tools (kind custom).",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
            "required": ["path", "sha256"],
            "additionalProperties": false
          }
        },
        "enrichers": { "type": "array", "items": { "$ref": "#/$defs/extensionRef" } },
        "callFilters": { "type": "array", "items": { "$ref": "#/$defs/extensionRef" } }
      },
      "required": ["artifacts", "enrichers", "callFilters"],
      "additionalProperties": false
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } },
          "requires": {
            "type": "object",
            "properties": { "config": { "type": "boolean" }, "configSchema": { "type": "string" } },
            "required": ["config"],
            "additionalProperties": false
          }
        },
        "required": ["id", "version", "tools", "requires"],
        "additionalProperties": false
      }
    },
    "schemas": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*@.+$" },
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "object" } }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "required": ["manifestVersion", "server", "build", "runtime", "instances", "apis", "exposure", "policies", "tools"],
  "additionalProperties": false,

  "$defs": {
    "extensionRef": {
      "type": "object",
      "properties": {
        "handler": { "type": "string" },
        "order": { "type": "integer" },
        "tools": { "type": "array", "items": { "type": "string" }, "description": "The tools a call filter applies to; absent: every tool" }
      },
      "required": ["handler", "order"],
      "additionalProperties": false
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },

    "allowedDefault": {
      "type": "object",
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "default": { "type": "string" }
      },
      "required": ["allowed"],
      "additionalProperties": false
    },

    "api": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "toolPrefix": { "type": "string" },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": { "type": "string" },
              "format": { "enum": ["swagger-2.0", "openapi-3.0", "openapi-3.1", "openapi-3.2"] },
              "digest": { "$ref": "#/$defs/digest" },
              "basePath": { "type": "string" },
              "default": { "type": "boolean" }
            },
            "required": ["version", "format", "digest", "basePath", "default"],
            "additionalProperties": false
          }
        },
        "detect": { "type": ["object", "null"] },
        "upstreamAuth": {
          "description": "How the server signs in to the API (manifests built before 0.4.0 name it downstreamAuth)",
          "type": "object",
          "properties": {
            "supported": { "type": "array", "items": { "type": "string" } },
            "identity": { "enum": ["service-account", "per-user"] },
            "unsatisfiedTools": { "enum": ["hide", "error"] },
            "fromRequest": {
              "type": "object",
              "properties": { "header": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$" } },
              "additionalProperties": false
            },
            "tokenExchange": { "type": "object", "additionalProperties": false },
            "schemes": {
              "description": "The kind of each security scheme the tools' security requirements name: basic, bearer, apiKey, oauth2ClientCredentials, mtls, oauth2 (other OAuth flows, OpenID Connect) or other",
              "type": "object",
              "additionalProperties": { "enum": ["basic", "bearer", "apiKey", "oauth2ClientCredentials", "mtls", "oauth2", "other"] }
            },
            "apiKey": {
              "type": "object",
              "properties": { "in": { "enum": ["header", "query", "cookie"] }, "name": { "type": "string" } },
              "required": ["in", "name"],
              "additionalProperties": false
            }
          },
          "required": ["supported"],
          "additionalProperties": false
        },
        "requestBody": { "type": "object" },
        "pagination": { "type": ["object", "null"] }
      },
      "required": ["id", "toolPrefix", "contracts", "upstreamAuth"],
      "additionalProperties": false
    },

    "annotations": {
      "type": "object",
      "properties": {
        "readOnlyHint": { "type": "boolean" },
        "destructiveHint": { "type": "boolean" },
        "idempotentHint": { "type": "boolean" },
        "openWorldHint": { "type": "boolean" }
      },
      "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
      "additionalProperties": false
    },

    "provenanceStep": {
      "type": "object",
      "properties": {
        "step": { "type": "string" },
        "value": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "pointer": { "type": "string" },
        "op": { "type": "string" },
        "since": { "type": "string" },
        "from": { "type": "string", "description": "The shared item the step comes from, as referenced: mcpgp://<workspace>/<kind>/<name>@<version>." }
      },
      "required": ["step"],
      "additionalProperties": false
    },

    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "kind": { "enum": ["api", "builtin", "pack", "custom"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "annotations": { "$ref": "#/$defs/annotations" },
        "sensitive": { "type": "boolean" },
        "confirm": { "type": "boolean" },
        "inputSchema": { "type": "object", "properties": { "type": { "const": "object" } }, "required": ["type"] },
        "outputSchema": { "type": ["object", "null"] },
        "api": { "type": "string" },
        "operation": {
          "type": "object",
          "properties": {
            "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[A-Z]+:/.*$" },
            "operationId": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["key"],
          "additionalProperties": false
        },
        "variants": { "type": "object", "additionalProperties": { "$ref": "#/$defs/variant" }, "minProperties": 1 },
        "handler": { "type": "string" },
        "pack": { "type": "string" },
        "provenance": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/provenanceStep" } }
        }
      },
      "required": ["name", "kind", "description", "annotations", "inputSchema"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "api" } } }, "then": { "required": ["api", "operation", "variants"] } },
        { "if": { "properties": { "kind": { "const": "builtin" } } }, "then": { "required": ["handler"] } },
        { "if": { "properties": { "kind": { "const": "pack" } } }, "then": { "required": ["pack"] } },
        { "if": { "properties": { "kind": { "const": "custom" } } }, "then": { "required": ["handler"] } }
      ]
    },

    "variant": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "pattern": "^/" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "in": { "enum": ["path", "query", "header", "cookie"] },
              "required": { "type": "boolean" },
              "style": { "type": "string" },
              "explode": { "type": "boolean" },
              "schema": { "type": "object" }
            },
            "required": ["name", "in", "required", "schema"],
            "additionalProperties": false
          }
        },
        "body": {
          "type": ["object", "null"],
          "properties": {
            "contentType": { "type": "string" },
            "required": { "type": "boolean" },
            "schema": { "type": "object" },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "contentTypes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "file": { "type": "boolean" },
                  "secret": { "type": "boolean" },
                  "required": { "type": "boolean" }
                },
                "required": ["name", "contentTypes", "file"],
                "additionalProperties": false
              }
            }
          },
          "required": ["contentType", "required", "schema"],
          "additionalProperties": false
        },
        "accept": { "type": "array", "items": { "type": "string" } },
        "security": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "scheme": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string" } } },
              "required": ["scheme"],
              "additionalProperties": false
            }
          }
        },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "pattern": "^([1-5][0-9X]{2}|default)$" },
              "contentType": { "type": "string" },
              "schema": { "type": "object" },
              "error": { "type": "boolean" }
            },
            "required": ["status"],
            "additionalProperties": false
          }
        }
      },
      "required": ["method", "path", "parameters", "accept"],
      "additionalProperties": false
    },

    "diagnostic": {
      "type": "object",
      "properties": {
        "level": { "enum": ["warning", "info"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string" },
        "operation": { "type": "string" },
        "reason": { "type": "string" },
        "tool": { "type": "string" },
        "location": {
          "type": "object",
          "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "pointer": { "type": "string" } },
          "required": ["file"],
          "additionalProperties": false
        }
      },
      "required": ["level", "code"],
      "additionalProperties": false
    }
  }
}
