{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitboyro.github.io/mcpgp/schemas/tool-tests.schema.json",
  "title": "mcpgp tool test cases",
  "description": "Test cases run by 'mcpgp test' against the mock target. See docs/guides/ci-pipeline.md.",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "tool": { "type": "string" },
          "args": { "type": "object" },
          "expect": {
            "type": "object",
            "properties": {
              "ok": { "type": "boolean" },
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "structured": { "type": "object" }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": ["name", "tool", "args", "expect"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cases"],
  "additionalProperties": false
}
