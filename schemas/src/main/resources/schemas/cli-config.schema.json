{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitboyro.github.io/mcpgp/schemas/cli-config.schema.json",
  "title": "mcpgp repository config",
  "description": ".mcpgp/config.yaml. See docs/spec/cli.md section 2.",
  "type": "object",
  "properties": {
    "cli": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "workspace": { "type": "string" },
    "platform": { "type": "string" },
    "servers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "out": { "type": "string" },
    "release": {
      "type": "object",
      "properties": {
        "versionFrom": { "type": "string", "pattern": "^(contract|git-tag|flag|file:.+)$" },
        "baseline": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sign": {
      "type": "object",
      "properties": { "key": { "type": "string" } },
      "additionalProperties": false
    }
  },
  "required": ["cli", "servers"],
  "additionalProperties": false
}
