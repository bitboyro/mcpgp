{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "$ref": "runtime-config.schema.json#/$defs/toolPolicy"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "settings": {
          "$ref": "#/$defs/inheritedSettings"
        },
        "audit": {
          "type": "object",
          "properties": {
            "file": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "rotate": {
                  "type": "string",
                  "pattern": "^(daily|hourly|size:[0-9]+)$"
                },
                "retainDays": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "arguments": {
              "enum": [
                "none",
                "redacted",
                "hashed"
              ]
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": {
              "enum": [
                "error",
                "warn",
                "info",
                "debug"
              ]
            },
            "target": {
              "enum": [
                "file",
                "stderr"
              ]
            }
          },
          "additionalProperties": false
        },
        "errors": {
          "type": "object",
          "properties": {
            "detail": {
              "enum": [
                "full",
                "summary"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requireReadOnly": {
          "type": "boolean"
        },
        "requireAudit": {
          "type": "boolean"
        },
        "minAuditRetainDays": {
          "type": "integer",
          "minimum": 1
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1
        },
        "maxPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "allowedTransports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "stdio",
              "http"
            ]
          }
        },
        "allowedAuthModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "none",
              "static",
              "oauth"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://bitboyro.github.io/mcpgp/schemas/organization-policy.schema.json"
}
