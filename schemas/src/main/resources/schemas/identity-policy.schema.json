{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "default": {
      "type": "object",
      "properties": {
        "tools": {
          "$ref": "runtime-config.schema.json#/$defs/toolPolicy"
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tools": {
            "$ref": "runtime-config.schema.json#/$defs/toolPolicy"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tools": {
            "$ref": "runtime-config.schema.json#/$defs/toolPolicy"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$id": "https://bitboyro.github.io/mcpgp/schemas/identity-policy.schema.json"
}
