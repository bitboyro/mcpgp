{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitboyro.github.io/mcpgp/schemas/naming-policy.schema.json",
  "title": "mcpgp naming policy",
  "description": "Naming pipeline settings, inline in a definition or as a shared policy file. See docs/spec/naming.md.",
  "type": "object",
  "properties": {
    "extends": { "type": "string" },
    "source": { "enum": ["operationId", "methodPath", "tagSummary"] },
    "fallback": { "enum": ["operationId", "methodPath", "tagSummary"] },
    "normalize": {
      "type": "object",
      "properties": {
        "split": { "type": "array", "items": { "enum": ["camel", "pascal", "kebab", "dot", "slash"] } },
        "dropWords": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "properties": {
        "order": { "enum": ["object_verb", "verb_object"] },
        "case": { "enum": ["snake", "camel", "kebab"] },
        "number": { "enum": ["singular", "keep"] }
      },
      "additionalProperties": false
    },
    "methodVerbs": {
      "type": "object",
      "description": "The verb per HTTP method when a name comes from method and path; LIST is GET on a collection. Defaults: GET get, LIST list, POST create, PUT replace, PATCH update, DELETE delete.",
      "propertyNames": { "enum": ["GET", "LIST", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,31}$" }
    },
    "vocabulary": { "type": "object", "additionalProperties": { "type": ["string", "null"] }, "description": "words (a|b) → replacement; null removes an entry the extended policy has" },
    "namespace": {
      "type": "object",
      "properties": {
        "server": { "type": "string" },
        "suffix": { "type": "string", "description": "added to the end of every API tool's name (before a content-type suffix), e.g. v2" },
        "perApi": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["strict", "mcp"] },
        "onTooLong": { "enum": ["shorten-then-hash", "error"] }
      },
      "additionalProperties": false
    },
    "collisions": { "enum": ["error", "method-path", "suffix-number", "suffix-contract"] }
  },
  "additionalProperties": false
}
