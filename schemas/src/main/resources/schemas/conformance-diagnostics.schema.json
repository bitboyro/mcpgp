{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitboyro.github.io/mcpgp/schemas/conformance-diagnostics.schema.json",
  "title": "mcpgp expected diagnostics",
  "description": "expected/diagnostics.json of a conformance case: what the compiler must report. See docs/spec/conformance.md.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "level": { "enum": ["error", "warning", "info"] },
      "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "location": {
        "type": "object",
        "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "pointer": { "type": "string" } },
        "required": ["file"],
        "additionalProperties": false
      },
      "messageContains": { "type": "string" }
    },
    "required": ["level", "code"],
    "additionalProperties": false
  }
}
