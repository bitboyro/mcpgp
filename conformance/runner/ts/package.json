{
  "name": "mcpgp-gate",
  "private": true,
  "version": "0.0.0",
  "description": "The release gate: packaged mcpgp servers driven by an independent MCP client against a validating API mock (docs/process/release-gate.md)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "vitest run",
    "gate:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
