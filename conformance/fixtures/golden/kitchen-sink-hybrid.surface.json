    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Get an item",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cookie": {
            "additionalProperties": false,
            "description": "Values sent as cookies.",
            "properties": {
              "view": {
                "enum": [
                  "short",
                  "full"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "path": {
            "additionalProperties": false,
            "description": "Values placed in the URL path.",
            "properties": {
              "itemId": {
                "pattern": "^[a-z0-9-]{1,36}$",
                "type": "string"
              }
            },
            "required": [
              "itemId"
            ],
            "type": "object"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "kitchen_item_get",
      "outputSchema": {
        "$defs": {
          "NewItem": {
            "properties": {
              "attributes": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "children": {
                "items": {
                  "$ref": "#/$defs/NewItem"
                },
                "maxItems": 3,
                "type": "array"
              },
              "kind": {
                "enum": [
                  "tool",
                  "part",
                  "kit"
                ],
                "type": "string"
              },
              "name": {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              "owner": {
                "properties": {
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "price": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "shape": {
                "oneOf": [
                  {
                    "properties": {
                      "kind": {
                        "const": "circle"
                      },
                      "radius": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "square"
                      },
                      "side": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    },
                    "type": "object"
                  }
                ]
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "maxItems": 5,
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "properties": {
          "value": {
            "allOf": [
              {
                "properties": {
                  "attributes": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "children": {
                    "items": {
                      "$ref": "#/$defs/NewItem"
                    },
                    "maxItems": 3,
                    "type": "array"
                  },
                  "kind": {
                    "enum": [
                      "tool",
                      "part",
                      "kit"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "owner": {
                    "properties": {
                      "email": {
                        "format": "email",
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "price": {
                    "minimum": 0,
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "shape": {
                    "oneOf": [
                      {
                        "properties": {
                          "kind": {
                            "const": "circle"
                          },
                          "radius": {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "square"
                          },
                          "side": {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      }
                    ]
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                  }
                },
                "type": "object"
              },
              {
                "properties": {
                  "created": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ]
          }
        },
        "type": "object"
      },
      "title": "Get an item"
    },
