        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Calls a tool found with search_tools. The same validation, confirmation and auth apply as for a directly listed tool.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "description": "The tool's arguments, as described by describe_tool.",
            "type": "object"
          },
          "name": {
            "description": "Tool name from search_tools.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "arguments"
        ],
        "type": "object"
      },
      "name": "call_tool",
      "title": "Call tool"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Returns a tool's full definition: description, input schema and annotations.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Tool name from search_tools.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "name": "describe_tool",
      "title": "Describe tool"
