# orders-mcp configured entirely from environment variables (no YAML file).
# Useful for containers and secret managers that only inject variables.

ORDERS_MCP_SERVER__TRANSPORT=http
ORDERS_MCP_SERVER__PORT=8080
ORDERS_MCP_SERVER__PUBLICURL=https://orders-mcp.acme.internal
ORDERS_MCP_SERVER__AUTH__MODE=static
ORDERS_MCP_SERVER__AUTH__KEYS_0__NAME=team-a
ORDERS_MCP_SERVER__AUTH__KEYS_0__VALUE=change-me

ORDERS_MCP_INSTANCES_0__ID=prod-eu
ORDERS_MCP_INSTANCES_0__BASEURL=https://orders-eu.acme.internal/api/v2
ORDERS_MCP_INSTANCES_0__AUTH__TYPE=basic
ORDERS_MCP_INSTANCES_0__AUTH__USERNAME=svc-mcp
ORDERS_MCP_INSTANCES_0__AUTH__PASSWORD=change-me
ORDERS_MCP_INSTANCES_0__TLS__CA__BASE64=LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0t...

ORDERS_MCP_INSTANCES_1__ID=partner-x
ORDERS_MCP_INSTANCES_1__BASEURL=https://orders.partner-x.example/api/v2
ORDERS_MCP_INSTANCES_1__CONTRACT=1.0
ORDERS_MCP_INSTANCES_1__AUTH__TYPE=apiKey
ORDERS_MCP_INSTANCES_1__AUTH__VALUE=change-me

ORDERS_MCP_AUDIT__FILE__PATH=/var/log/orders-mcp/audit.jsonl
ORDERS_MCP_TELEMETRY__ENABLED=false
